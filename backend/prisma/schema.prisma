// Xeno multi-tenant schema.
//
// Conventions
// - Tables and columns are snake_case in SQL (orders.total_price), camelCase in JS (order.totalPrice).
// - Every Shopify-derived table has tenant_id (FK to tenants, indexed) so each store's data is isolated.
// - Shopify IDs are stored as text: they are identifiers, not numbers we do maths on.
// - Money is DECIMAL(12,2) and always INR (single-currency platform). Timestamps are TIMESTAMPTZ.
// - On Shopify-derived tables, created_at / updated_at hold Shopify's own values;
//   synced_at is when we last wrote the row.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Platform tables
// ---------------------------------------------------------------------------

/// A retailer onboarded onto Xeno. One tenant = one Shopify store.
model Tenant {
  id                 String    @id @default(uuid()) @db.Uuid
  name               String
  /// e.g. "my-store.myshopify.com". Null until the store is connected.
  shopDomain         String?   @unique @map("shop_domain")
  shopifyAccessToken String?   @map("shopify_access_token")
  isActive           Boolean   @default(true) @map("is_active")
  lastSyncedAt       DateTime? @map("last_synced_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  users          User[]
  customers      Customer[]
  products       Product[]
  orders         Order[]
  orderLineItems OrderLineItem[]
  events         Event[]
  syncLogs       SyncLog[]

  @@map("tenants")
}

/// Someone who logs in to the dashboard. Belongs to exactly one tenant.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Shopify-derived tables (all tenant-scoped)
// ---------------------------------------------------------------------------

model Customer {
  id                Int      @id @default(autoincrement())
  tenantId          String   @map("tenant_id") @db.Uuid
  shopifyCustomerId String   @map("shopify_customer_id")
  email             String?
  firstName         String?  @map("first_name")
  lastName          String?  @map("last_name")
  phone             String?
  ordersCount       Int      @default(0) @map("orders_count")
  totalSpent        Decimal  @default(0) @map("total_spent") @db.Decimal(12, 2)
  createdAt         DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @map("updated_at") @db.Timestamptz(3)
  syncedAt          DateTime @default(now()) @updatedAt @map("synced_at") @db.Timestamptz(3)

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders Order[]
  events Event[]

  // The unique index starts with tenant_id, so it also serves tenant_id lookups.
  @@unique([tenantId, shopifyCustomerId])
  @@index([tenantId, totalSpent])
  @@map("customers")
}

model Product {
  id               Int      @id @default(autoincrement())
  tenantId         String   @map("tenant_id") @db.Uuid
  shopifyProductId String   @map("shopify_product_id")
  title            String
  vendor           String?
  productType      String?  @map("product_type")
  status           String?
  /// Lowest variant price
  price            Decimal? @db.Decimal(12, 2)
  createdAt        DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @map("updated_at") @db.Timestamptz(3)
  syncedAt         DateTime @default(now()) @updatedAt @map("synced_at") @db.Timestamptz(3)

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lineItems OrderLineItem[]

  @@unique([tenantId, shopifyProductId])
  @@map("products")
}

model Order {
  id                Int       @id @default(autoincrement())
  tenantId          String    @map("tenant_id") @db.Uuid
  shopifyOrderId    String    @map("shopify_order_id")
  /// Shopify's display name, e.g. "#1001"
  orderNumber       String?   @map("order_number")
  /// Null for guest checkouts
  customerId        Int?      @map("customer_id")
  email             String?
  subtotalPrice     Decimal   @default(0) @map("subtotal_price") @db.Decimal(12, 2)
  totalDiscounts    Decimal   @default(0) @map("total_discounts") @db.Decimal(12, 2)
  totalTax          Decimal   @default(0) @map("total_tax") @db.Decimal(12, 2)
  totalPrice        Decimal   @default(0) @map("total_price") @db.Decimal(12, 2)
  financialStatus   String?   @map("financial_status")
  fulfillmentStatus String?   @map("fulfillment_status")
  cancelledAt       DateTime? @map("cancelled_at") @db.Timestamptz(3)
  createdAt         DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @map("updated_at") @db.Timestamptz(3)
  syncedAt          DateTime  @default(now()) @updatedAt @map("synced_at") @db.Timestamptz(3)

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer  Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lineItems OrderLineItem[]

  @@unique([tenantId, shopifyOrderId])
  @@index([tenantId, createdAt])
  @@index([customerId])
  @@map("orders")
}

model OrderLineItem {
  id                Int     @id @default(autoincrement())
  tenantId          String  @map("tenant_id") @db.Uuid
  orderId           Int     @map("order_id")
  /// Null if the product was deleted or is not synced
  productId         Int?    @map("product_id")
  shopifyLineItemId String  @map("shopify_line_item_id")
  shopifyProductId  String? @map("shopify_product_id")
  title             String
  variantTitle      String? @map("variant_title")
  sku               String?
  quantity          Int
  /// Unit price
  price             Decimal @db.Decimal(12, 2)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([tenantId, shopifyLineItemId])
  @@index([orderId])
  @@index([productId])
  @@map("order_line_items")
}

enum EventType {
  CHECKOUT_STARTED @map("checkout_started")
  CART_ABANDONED   @map("cart_abandoned")

  @@map("event_type")
}

/// Custom storefront events (bonus scope): checkout started, cart abandoned.
model Event {
  id                Int       @id @default(autoincrement())
  tenantId          String    @map("tenant_id") @db.Uuid
  type              EventType
  /// Null for anonymous visitors
  customerId        Int?      @map("customer_id")
  shopifyCheckoutId String?   @map("shopify_checkout_id")
  email             String?
  /// Cart value at the time of the event
  totalPrice        Decimal?  @map("total_price") @db.Decimal(12, 2)
  /// Raw Shopify payload, kept for debugging and future metrics
  payload           Json?
  occurredAt        DateTime  @map("occurred_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Same checkout reported twice (webhook retry) must not create a duplicate event.
  @@unique([tenantId, type, shopifyCheckoutId])
  @@index([tenantId, type, occurredAt])
  @@index([customerId])
  @@map("events")
}

// ---------------------------------------------------------------------------
// Sync bookkeeping
// ---------------------------------------------------------------------------

enum SyncResource {
  CUSTOMERS @map("customers")
  PRODUCTS  @map("products")
  ORDERS    @map("orders")
  EVENTS    @map("events")

  @@map("sync_resource")
}

enum SyncTrigger {
  MANUAL    @map("manual")
  SCHEDULER @map("scheduler")
  WEBHOOK   @map("webhook")

  @@map("sync_trigger")
}

enum SyncStatus {
  RUNNING @map("running")
  SUCCESS @map("success")
  FAILED  @map("failed")

  @@map("sync_status")
}

/// One row per sync run, so we can see what was synced, when, and whether it failed.
model SyncLog {
  id            Int          @id @default(autoincrement())
  tenantId      String       @map("tenant_id") @db.Uuid
  resource      SyncResource
  trigger       SyncTrigger
  status        SyncStatus   @default(RUNNING)
  recordsSynced Int          @default(0) @map("records_synced")
  errorMessage  String?      @map("error_message")
  startedAt     DateTime     @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt    DateTime?    @map("finished_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, startedAt])
  @@map("sync_logs")
}
