# Server
PORT=5000
NODE_ENV=development

# Database (Railway DATABASE_PUBLIC_URL for local dev)
DATABASE_URL=postgresql://user:password@host:5432/xeno

# Auth: any long random string
JWT_SECRET=change-me-to-a-long-random-string

# CORS: allowed frontend origin
FRONTEND_URL=http://localhost:3000

# Shopify dev store (see docs/shopify-setup.md)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-10
